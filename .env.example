# Application Settings
APP_NAME="Research Paper Automation & Journal Readiness Platform"
APP_VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# Database (SQLite by default for zero-config hackathon demo; set to PostgreSQL for production)
DATABASE_URL=sqlite:///./research_platform.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/research_paper_db

# Storage Service ("local" or "s3")
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# S3 Object Storage (when STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=my-research-papers
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=your_key
# S3_SECRET_KEY=your_secret

# AI / LLM Evaluation Engine ("mock", "openai", "gemini")
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45

# RAG & Embeddings ("deterministic", "sentence_transformers", "openai")
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSION=384
VECTOR_TOP_K=5

# Async Job Processing ("threaded" for standalone demo or "celery" for production)
ASYNC_PROCESSING_MODE=threaded
# REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production-12345
ALLOWED_ORIGINS=["*"]
